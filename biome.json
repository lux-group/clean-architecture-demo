{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**/*.*"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "bracketSpacing": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**/*"],
                    "message": "Use ~/ instead of ../.."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["~/app/**/*", "~/domain/**/*", "~/infrastructure/**/*"],
                    "message": "Library folder cannot import from other folders - this violates clean architecture principles"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**/*.ts", "!src/app/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["~/infrastructure/**/*"],
                    "message": "Application layer cannot import from infrastructure layer - this violates clean architecture principles"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**/*.ts", "!src/domain/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["~/app/**/*", "~/infrastructure/**/*"],
                    "message": "Domain layer cannot import from application or infrastructure layer - this violates clean architecture principles"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
