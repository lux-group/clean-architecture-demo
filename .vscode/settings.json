{
  "cSpell.words": [
    "awilix",
    "entra",
    "frontchannel",
    "PKCE",
    "Uncapitalize",
    "Unprefix",
    "valkey"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "vitest.enable": true,
  "vitest.commandLine": "npm run test",
  "vitest.include": ["**/*.{test,spec}.ts"],
  "testing.automaticallyOpenTestResults": "openOnTestStart"
}